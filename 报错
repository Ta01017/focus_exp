def resize\_keep\_aspect\_no\_crop(image, max\_pixels=None, height=None, width=None, div=16):



    w, h = image.size







    if height is not None and width is not None:



        scale = min(width / w, height / h)



        new\_w = max(1, int(w \* scale))



        new\_h = max(1, int(h \* scale))



    else:



        new\_w, new\_h = w, h



        if max\_pixels is not None and w \* h > max\_pixels:



            scale = math.sqrt(max\_pixels / float(w \* h))



            new\_w = max(1, int(w \* scale))



            new\_h = max(1, int(h \* scale))







    new\_w = max(div, (new\_w // div) \* div)



    new\_h = max(div, (new\_h // div) \* div)







    image = TF.resize(



        image,



        (new\_h, new\_w),



        interpolation=InterpolationMode.BILINEAR



    )



    return image















class FocusFusionDataset(Dataset):



    def \_\_init\_\_(



        self,



        base\_path,



        metadata\_path,



        repeat=1,



        max\_pixels=None,



        height=None,



        width=None,



        div=16,



        max\_data\_items=None,



    ):



        self.base\_path = base\_path



        self.metadata\_path = metadata\_path



        self.repeat = repeat



        self.max\_pixels = max\_pixels



        self.height = height



        self.width = width



        self.div = div



        self.max\_data\_items = max\_data\_items







        \# 兼容 diffsynth runner



        self.load\_from\_cache = False



        self.cached\_data = []







        with open(metadata\_path, "r", encoding="utf-8") as f:



            self.data = json.load(f)







        if self.max\_data\_items is not None:



            self.data = self.data[:self.max\_data\_items]







    def \_abs\_path(self, rel\_path):



        return os.path.join(self.base\_path, rel\_path)







    def \_load\_rgb(self, rel\_path):



        path = self.\_abs\_path(rel\_path)



        img = Image.open(path).convert("RGB")



        return img







    def \_\_getitem\_\_(self, idx):



        item = self.data[idx % len(self.data)]







        target = self.\_load\_rgb(item["image"])



        edit\_a = self.\_load\_rgb(item["edit\_image"][0])



        edit\_b = self.\_load\_rgb(item["edit\_image"][1])







        \# 用 target 的结果统一三张图尺寸



        target = resize\_keep\_aspect\_no\_crop(



            target,



            max\_pixels=self.max\_pixels,



            height=self.height,



            width=self.width,



            div=self.div,



        )







        tw, th = target.size







        edit\_a = TF.resize(



            edit\_a,



            (th, tw),



            interpolation=InterpolationMode.BILINEAR



        )



        edit\_b = TF.resize(



            edit\_b,



            (th, tw),



            interpolation=InterpolationMode.BILINEAR



        )







        return {



            "image": target,



            "edit\_image": [edit\_a, edit\_b],



            "prompt": item["prompt"],



        }







    def \_\_len\_\_(self):



        return len(self.data) \* self.repeat















import torch.nn.functional as F



from einops import rearrange







def FlowMatchSFTPixelL1Loss(



    pipe,



    pixel\_loss\_weight=0.05,



    \*\*inputs,



):



    max\_timestep\_boundary = int(inputs.get("max\_timestep\_boundary", 1) \* len(pipe.scheduler.timesteps))



    min\_timestep\_boundary = int(inputs.get("min\_timestep\_boundary", 0) \* len(pipe.scheduler.timesteps))







    timestep\_id = torch.randint(min\_timestep\_boundary, max\_timestep\_boundary, (1,))



    timestep = pipe.scheduler.timesteps[timestep\_id].to(



        dtype=pipe.torch\_dtype,



        device=pipe.device,



    )







    noise = torch.randn\_like(inputs["input\_latents"])



    inputs["latents"] = pipe.scheduler.add\_noise(



        inputs["input\_latents"],



        noise,



        timestep,



    )







    training\_target = pipe.scheduler.training\_target(



        inputs["input\_latents"],



        noise,



        timestep,



    )







    models = {name: getattr(pipe, name) for name in pipe.in\_iteration\_models}







    velocity\_pred = pipe.model\_fn(



        \*\*models,



        \*\*inputs,



        timestep=timestep,



    )







    \# ===== FlowMatch loss =====



    flow\_loss = F.mse\_loss(



        velocity\_pred.float(),



        training\_target.float(),



    )



    flow\_loss = flow\_loss \* pipe.scheduler.training\_weight(timestep)







    \# ===== Pixel L1 loss =====



    sigma = pipe.scheduler.sigmas[timestep\_id].to(



        dtype=velocity\_pred.dtype,



        device=velocity\_pred.device,



    )



    sigma = sigma.reshape(1, 1, 1)







    clean\_latents\_pred = inputs["latents"] - sigma \* velocity\_pred







    height = int(inputs["height"])



    width = int(inputs["width"])



    latent\_h, latent\_w = height // 16, width // 16







    clean\_latents\_pred = rearrange(



        clean\_latents\_pred,



        "B (H W) C -> B C H W",



        H=latent\_h,



        W=latent\_w,



    )







    pred\_image = pipe.vae.decode(clean\_latents\_pred).clamp(-1, 1)







    \# target image（用 input\_image 即 GT）



    target\_image = pipe.preprocess\_image(



        inputs["input\_image"],



        torch\_dtype=pipe.torch\_dtype,



        device=pipe.device,



    )







    if target\_image.shape[-2:] != pred\_image.shape[-2:]:



        target\_image = F.interpolate(



            target\_image,



            size=pred\_image.shape[-2:],



            mode="bilinear",



            align\_corners=False,



        )







    pixel\_l1 = F.l1\_loss(



        pred\_image.float(),



        target\_image.float(),



    )







    return flow\_loss + pixel\_loss\_weight \* pixel\_l1















