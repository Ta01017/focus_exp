def build_pipeline(device: str, torch_dtype: torch.dtype, lora_path: Optional[str] = None):



    pipe = Flux2ImagePipeline.from_pretrained(



        torch_dtype=torch_dtype,



        device=device,



        model_configs=[



            ModelConfig(model_id="black-forest-labs/FLUX.2-klein-4B", origin_file_pattern="text_encoder/*.safetensors"),



            ModelConfig(model_id="black-forest-labs/FLUX.2-klein-4B", origin_file_pattern="transformer/*.safetensors"),



            ModelConfig(model_id="black-forest-labs/FLUX.2-klein-4B", origin_file_pattern="vae/diffusion_pytorch_model.safetensors"),



        ],



        tokenizer_config=ModelConfig(model_id="black-forest-labs/FLUX.2-klein-4B", origin_file_pattern="tokenizer/"),



    )







    if lora_path is not None and len(lora_path) > 0:



        print(f"[INFO] Loading LoRA: {lora_path}")



        pipe.load_lora(pipe.dit, lora_path)







    return pipe











@torch.inference_mode()



def run_one(



    pipe,



    a_path: str,



    b_path: str,



    focus_a_path: Optional[str],



    prompt: str,



    negative_prompt: str,



    num_inference_steps: int,



    seed: int,



    max_pixels: int,



    cfg_scale: float,



    embedded_guidance: float,



    restore_to_original_size: bool,



) -> Image.Image:



    img_a = Image.open(a_path).convert("RGB")



    img_b = Image.open(b_path).convert("RGB")







    orig_w, orig_h = img_a.size



    height, width = aligned_hw_from_image(img_a, max_pixels=max_pixels, align=16)







    img_a_resized = img_a.resize((width, height), Image.BILINEAR)



    img_b_resized = img_b.resize((width, height), Image.BILINEAR)







    edit_images = [img_a_resized, img_b_resized]







    if focus_a_path is not None:



        img_focus = Image.open(focus_a_path).convert("RGB")



        img_focus = img_focus.resize((width, height), Image.BILINEAR)



        edit_images.append(img_focus)







    image = pipe(



        prompt=prompt,



        negative_prompt=negative_prompt,



        input_image=img_a_resized,



        edit_image=edit_images,



        seed=seed,



        num_inference_steps=num_inference_steps,



        cfg_scale=cfg_scale,



        embedded_guidance=embedded_guidance,



        height=height,



        width=width,



    )







    if restore_to_original_size and image.size != (orig_w, orig_h):



        image = image.resize((orig_w, orig_h), Image.BILINEAR)







    return image



