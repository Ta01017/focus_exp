def main():



    parser = argparse.ArgumentParser(description="Batch multi-focus fusion inference for FLUX.2-klein-base-4B")



    parser.add_argument("--input_dir", type=str, default=None, help="输入目录，扫描 *_a / *_b")



    parser.add_argument("--metadata_path", type=str, default=None, help="metadata.json 路径；给了它就优先按 metadata 读取")



    parser.add_argument("--dataset_base_path", type=str, default=None, help="配合 metadata 使用的数据根目录")



    parser.add_argument("--output_dir", type=str, required=True, help="输出目录")



    parser.add_argument("--lora_path", type=str, default="", help="LoRA safetensors 路径")



    parser.add_argument("--prompt", type=str, default="Multi-focus image fusion. Preserve sharp regions.")



    parser.add_argument("--negative_prompt", type=str, default="", help="负向提示词")



    parser.add_argument("--num_inference_steps", type=int, default=28)



    parser.add_argument("--seed", type=int, default=0)



    parser.add_argument("--max_pixels", type=int, default=4194304)



    parser.add_argument("--cfg_scale", type=float, default=1.0)



    parser.add_argument("--embedded_guidance", type=float, default=1.0)



    parser.add_argument("--device", type=str, default="cuda")



    parser.add_argument("--dtype", type=str, default="bf16", choices=["bf16", "fp16", "fp32"])



    parser.add_argument("--restore_to_original_size", action="store_true")



    args = parser.parse_args()







    if args.metadata_path is None and args.input_dir is None:



        raise ValueError("至少给一个 --input_dir 或 --metadata_path")







    ensure_dir(Path(args.output_dir))







    if args.dtype == "bf16":



        torch_dtype = torch.bfloat16



    elif args.dtype == "fp16":



        torch_dtype = torch.float16



    else:



        torch_dtype = torch.float32







    pipe = build_pipeline(



        device=args.device,



        torch_dtype=torch_dtype,



        lora_path=args.lora_path if args.lora_path else None,



    )







    if args.metadata_path is not None:



        if args.dataset_base_path is None:



            raise ValueError("使用 metadata 时需要同时提供 --dataset_base_path")



        pairs = collect_pairs_from_metadata(Path(args.dataset_base_path), Path(args.metadata_path))



    else:



        pairs = collect_pairs_from_suffixes(Path(args.input_dir))







    print(f"[INFO] Found {len(pairs)} pairs")







    manifest = []







    for idx, item in enumerate(tqdm(pairs, desc="Infer")):



        sample_id = item["id"]



        a_path = item["a"]



        b_path = item["b"]



        #focus_a_path=item[""]



        prompt = item.get("prompt", None) or args.prompt



        out_img = run_one(



            pipe=pipe,



            a_path=a_path,



            b_path=b_path,



            focus_a_path=item.get("focus_a", None),



            prompt=prompt,



            negative_prompt=args.negative_prompt,



            num_inference_steps=args.num_inference_steps,



            seed=args.seed + idx,



            max_pixels=args.max_pixels,



            cfg_scale=args.cfg_scale,



            embedded_guidance=args.embedded_guidance,



            restore_to_original_size=args.restore_to_original_size,



        )



        # out_img = run_one(



        #     pipe=pipe,



        #     a_path=a_path,



        #     b_path=b_path,



        #     prompt=prompt,



        #     negative_prompt=args.negative_prompt,



        #     num_inference_steps=args.num_inference_steps,



        #     seed=args.seed + idx,



        #     max_pixels=args.max_pixels,



        #     cfg_scale=args.cfg_scale,



        #     embedded_guidance=args.embedded_guidance,



        #     restore_to_original_size=args.restore_to_original_size,



        # )







        out_path = Path(args.output_dir) / f"{sample_id}_pred.png"



        out_img.save(out_path)







        manifest.append({



            "id": sample_id,



            "a": a_path,



            "b": b_path,



            "focus_a": item.get("focus_a", None),



            "output": str(out_path),



            "prompt": prompt,



            "negative_prompt": args.negative_prompt,



        })







    with open(Path(args.output_dir) / "manifest.json", "w", encoding="utf-8") as f:



        json.dump(manifest, f, ensure_ascii=False, indent=2)







    print(f"[INFO] Done. Results saved to: {args.output_dir}")











if __name__ == "__main__":



    main()







