def ensure_dir(path: Path):



    path.mkdir(parents=True, exist_ok=True)











def is_image_file(p: Path) -> bool:



    return p.suffix.lower() in [".jpg", ".jpeg", ".png", ".bmp", ".webp", ".tif", ".tiff"]











def aligned_hw_from_image(



    image: Image.Image,



    max_pixels: int = 2097152,



    align: int = 16,



) -> tuple[int, int]:



    w, h = image.size







    if w * h > max_pixels:



        scale = math.sqrt(max_pixels / float(w * h))



        w = max(1, int(w * scale))



        h = max(1, int(h * scale))







    w = max(align, (w // align) * align)



    h = max(align, (h // align) * align)







    return h, w











def collect_pairs_from_suffixes(input_dir: Path) -> List[Dict]:



    a_files = sorted([p for p in input_dir.rglob("*") if p.is_file() and is_image_file(p) and p.stem.endswith("_a")])



    pairs = []







    for a_path in a_files:



        base = a_path.stem[:-2]



        b_path = a_path.with_name(base + "_b" + a_path.suffix)







        if not b_path.exists():



            candidates = list(a_path.parent.glob(base + "_b.*"))



            candidates = [x for x in candidates if x.is_file() and is_image_file(x)]



            if len(candidates) == 0:



                print(f"[WARN] 缺少配对 b 图，跳过: {a_path}")



                continue



            b_path = candidates[0]







        pairs.append({



            "id": base,



            "a": str(a_path),



            "b": str(b_path),



        })







    return pairs











def collect_pairs_from_metadata(base_path: Path, metadata_path: Path) -> List[Dict]:



    with open(metadata_path, "r", encoding="utf-8") as f:



        metadata = json.load(f)







    pairs = []



    for i, item in enumerate(metadata):



        edit_images = item.get("edit_image", None)







        # 兼容 [a,b] 或 [a,b,focus_a]



        if not isinstance(edit_images, list) or len(edit_images) < 2:



            print(f"[WARN] metadata 第 {i} 项 edit_image 少于2张，跳过")



            continue







        a = base_path / edit_images[0]



        b = base_path / edit_images[1]







        focus_a = None



        if len(edit_images) >= 3:



            focus_a = base_path / edit_images[2]







        sample_id = (



            Path(edit_images[0]).stem[:-2]



            if Path(edit_images[0]).stem.endswith("_a")



            else f"sample_{i:06d}"



        )







        pairs.append({



            "id": sample_id,



            "a": str(a),



            "b": str(b),



            "focus_a": str(focus_a) if focus_a is not None else None,



            "prompt": item.get("prompt", None),



        })







    return pairs



