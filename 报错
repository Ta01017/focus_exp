    def get\_pipeline\_inputs(self, data):



        inputs\_posi = {"prompt": data["prompt"]}



        inputs\_nega = {"negative\_prompt": ""}







        inputs\_shared = {



            "input\_image": data["image"],



            "height": data["image"].size[1],



            "width": data["image"].size[0],



            "embedded\_guidance": 1.0,



            "cfg\_scale": 1,



            "rand\_device": self.pipe.device,



            "use\_gradient\_checkpointing": self.use\_gradient\_checkpointing,



            "use\_gradient\_checkpointing\_offload": self.use\_gradient\_checkpointing\_offload,



        }







        inputs\_shared = self.parse\_extra\_inputs(data, self.extra\_inputs, inputs\_shared)



        return inputs\_shared, inputs\_posi, inputs\_nega







    def forward(self, data, inputs=None):



        if inputs is None:



            inputs = self.get\_pipeline\_inputs(data)







        inputs = self.transfer\_data\_to\_device(inputs, self.pipe.device, self.pipe.torch\_dtype)







        for unit in self.pipe.units:



            inputs = self.pipe.unit\_runner(unit, self.pipe, \*inputs)







        loss = self.task\_to\_loss[self.task]\(self.pipe, \*inputs)



        return loss















